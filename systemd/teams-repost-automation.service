[Unit]
Description=Teams Repost automation worker
After=network-online.target teams-repost.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/teams-repost
EnvironmentFile=/var/www/teams-repost/.env
ExecStart=/var/www/teams-repost/.venv/bin/python -m automation_worker --once
User=teams-repost
Group=teams-repost
